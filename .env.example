# Supabase project credentials.
# Find these in the Supabase dashboard under Project Settings → API.
# Both values are safe to expose to the browser; row level security is what
# protects your data, so keep RLS enabled on every table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
