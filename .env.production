# Build-time values for production builds.
#
# Next.js inlines NEXT_PUBLIC_* when it builds, so these must exist in the build
# environment — wrangler.jsonc vars only apply at runtime, which is too late.
# Committing them is deliberate: both are publishable, and row level security is
# what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://gezrztmxyxbtbbasvbix.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7cNwGYry3xq_-zboLS8RTQ_IVLHRiA6

# Confirmation links are built from this. Behind a proxy the request headers
# describe the hop rather than the address the user typed, so it is set explicitly.
NEXT_PUBLIC_SITE_URL=https://nutri.aniascapital.workers.dev
